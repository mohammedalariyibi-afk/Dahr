# Dahr Next.js admin. Copy to `.env.local` (gitignored) and fill values.
# Never commit cloud keys or the service_role key. Do not use the Zeen project.
#
# Admin must use NEXT_PUBLIC_* so the browser client can read them.
# Flutter uses the same URL + anon key under SUPABASE_URL / SUPABASE_ANON_KEY
# (no NEXT_PUBLIC_ prefix).

# --- Local (`supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# --- Cloud: Dahr LY (eu-west-1, ref cccusktgxrizfwpixddu) ---
# NEXT_PUBLIC_SUPABASE_URL=https://cccusktgxrizfwpixddu.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<Project Settings → API → anon / publishable key>
