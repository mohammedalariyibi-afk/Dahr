# Dahr Flutter environment. Copy to `.env` (gitignored) and fill values.
# Never commit cloud keys or the service_role key. Do not use the Zeen project.
#
# How the app reads these (first non-empty wins):
#   1. --dart-define / --dart-define-from-file=.env
#   2. flutter_dotenv from the bundled `.env.example` asset
# supabase_flutter initialize() takes url + publishableKey (the anon key).
#
# Required names: SUPABASE_URL and SUPABASE_ANON_KEY
# Alias: SUPABASE_PUBLISHABLE_KEY (same value as the anon/publishable key)

# --- Local (`supabase start`) ---
# API URL is always http://127.0.0.1:54321
# Anon/publishable key: copy from `supabase start` or `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key

# Optional alias (newer dashboard label). Used only if SUPABASE_ANON_KEY is empty.
# SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# --- Cloud: Dahr LY (eu-west-1, ref cccusktgxrizfwpixddu) ---
# SUPABASE_URL=https://cccusktgxrizfwpixddu.supabase.co
# SUPABASE_ANON_KEY=<Project Settings → API → anon / publishable key>
